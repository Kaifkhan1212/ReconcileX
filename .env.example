# Database Configuration
DB_NAME=reconcilex_app
DB_USERNAME=reconcilex_app
DB_PASSWORD=your_db_password_here
DB_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/reconcilex_app

# Server Port
SERVER_PORT=8081

# JWT Security (Minimum 32 bytes UTF-8)
JWT_SECRET=your_32_plus_character_secure_jwt_secret_key_here

# Initial Bootstrap Administrator (Minimum 12 characters password)
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=your_secure_admin_password_min_12_chars
